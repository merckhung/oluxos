#!/bin/sh
# SSH server (Dropbear). Host keys are created on first use; logins are by
# key: put an authorized_keys file on the boot partition (/boot) or in
# /data/ssh, or add keys to /root/.ssh/authorized_keys at run time.
case "$1" in
  start)
    mkdir -p /root/.ssh /etc/dropbear
    chmod 700 /root/.ssh
    for f in /boot/authorized_keys /data/ssh/authorized_keys; do
      [ -r "$f" ] && cat "$f" >>/root/.ssh/authorized_keys
    done
    [ -f /root/.ssh/authorized_keys ] && chmod 600 /root/.ssh/authorized_keys
    # persist host keys on /data when it is writable
    if [ -d /data ] && touch /data/.probe 2>/dev/null; then
      rm -f /data/.probe
      mkdir -p /data/ssh
      for k in /data/ssh/dropbear_*_host_key; do
        [ -f "$k" ] && cp "$k" /etc/dropbear/
      done
    fi
    ;;
esac
exit 0
