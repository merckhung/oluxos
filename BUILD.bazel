load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

package(default_visibility = ["//visibility:public"])

COMMON_COPTS = [
    "-m32",
    "-Wall",
    "-Wstrict-prototypes",
    "-O2",
    "-fomit-frame-pointer",
    "-nostdinc",
    "-fno-stack-protector",
    "-fno-pie",
    "-fno-pic",
    "-ffreestanding",
    "-fno-builtin",
    "-std=gnu89",
    "-include", "include/types.h",
]

COMMON_DEFINES = [
    "KERNEL_DEBUG",
    "CONFIG_ARCH_IA32=1",
    "CONFIG_MENU=1",
    "CONFIG_SERIAL_CONSOLE=1",
    "CONFIG_SERIAL=1",
    "CONFIG_KERNEL_GDB=1",
    "CONFIG_FS_FAT=1",
    "CONFIG_KDBGER=0",
]

cc_library(
    name = "olux_headers",
    hdrs = glob(["include/**/*.h"]),
    includes = ["include"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "kernel_lib",
    srcs = [
        "fs/fat.c",
        "driver/input/kbd.c",
        "driver/ide/ide.c",
        "driver/pci/pci.c",
        "driver/serial/serial.c",
        "driver/console/menu.c",
        "driver/console/ksh.c",
        "driver/console/sercon.c",
        "driver/console/console.c",
        "driver/resource/resource.c",
        "arch/ia32/kernel/setup.S",
        "arch/ia32/kernel/handler.S",
        "arch/ia32/kernel/page.c",
        "arch/ia32/kernel/interrupt.c",
        "arch/ia32/kernel/krn.c",
        "arch/ia32/kernel/task.c",
        "arch/ia32/component/timer.c",
        "arch/ia32/component/i8259.c",
        "arch/ia32/lib/kdbger.c",
        "arch/ia32/lib/debug.c",
        "arch/ia32/lib/gdb.c",
        "arch/ia32/lib/io.c",
        "lib/clib.c",
        "lib/crc.c",
    ] + glob(["**/*.h"]),
    copts = COMMON_COPTS,
    local_defines = COMMON_DEFINES,
    includes = ["include"],
    deps = [":olux_headers"],
    linkstatic = True,
)
cc_library(
    name = "bootsect_lib",
    srcs = [
        "arch/ia32/boot/boot.S",
        "arch/ia32/boot/info.S",
        "arch/ia32/boot/pm.S",
    ] + glob(["**/*.h"]),
    copts = COMMON_COPTS,
    local_defines = COMMON_DEFINES,
    includes = ["include"],
    deps = [":olux_headers"],
    linkstatic = True,
)

genrule(
    name = "kernel_elf",
    srcs = [":kernel_lib", "arch/ia32/kernel.lds"],
    outs = ["kernel.elf"],
    cmd = "ld -m elf_i386 -nostdlib -static -n -N -T $(location arch/ia32/kernel.lds) $(locations :kernel_lib) -o $@",
)

genrule(
    name = "bootsect_elf",
    srcs = [":bootsect_lib", "arch/ia32/boot/boot.lds"],
    outs = ["bootsect.elf"],
    cmd = "ld -m elf_i386 -nostdlib -static -n -N -T $(location arch/ia32/boot/boot.lds) $(locations :bootsect_lib) -o $@",
)

genrule(
    name = "kernel_bin",
    srcs = [":kernel_elf"],
    outs = ["kernel"],
    cmd = "cp $< $@",
)

genrule(
    name = "bootsect_bin",
    srcs = [":bootsect_elf"],
    outs = ["bootsect"],
    cmd = "cp $< $@",
)

genrule(
    name = "OluxOS_krn",
    srcs = [
        ":bootsect_bin",
        ":kernel_bin",
    ],
    outs = ["OluxOS.krn"],
    tools = ["//utils:krnimg"],
    cmd = "$(location //utils:krnimg) -b $(location :bootsect_bin) -k $(location :kernel_bin) -o $@",
)

genrule(
    name = "OluxOS_img",
    srcs = [":OluxOS_krn"],
    outs = ["OluxOS.img"],
    cmd = "dd if=/dev/zero of=$@ bs=1474560 count=1 && dd if=$(location :OluxOS_krn) of=$@ bs=1474560 count=1 conv=notrunc",
)

sh_binary(
    name = "run_qemu",
    srcs = ["run_qemu.sh"],
    data = [":OluxOS_img"],
    args = ["$(location :OluxOS_img)"],
)

genrule(
    name = "user_shell_elf",
    srcs = [
        "user/shell.c",
        "user/start.S",
        "user/user.lds",
        "user/ulib/string.h",
        "user/ulib/string.c",
        "user/ulib/stdio.h",
        "user/ulib/stdio.c",
        "user/ulib/syscall.h",
        "user/ulib/unistd.h",
        "user/ulib/unistd.c",
        "user/ulib/dirent.h",
        "user/ulib/dirent.c",
        "user/ulib/gles.h",
        "user/ulib/gles.c",
        "user/ulib/gui.h",
        "user/ulib/gui.c",
        "user/ulib/gui_font.h",
        "user/ulib/ext4.h",
        "user/ulib/ext4.c",
    ] + glob(["include/**/*.h"]),
    outs = ["user_shell.elf"],
    cmd = "aarch64-linux-gnu-gcc -Wall -O0 -nostdlib -nostartfiles -static -Wl,--build-id=none -ffreestanding -std=gnu89 -mgeneral-regs-only -T $(location user/user.lds) $(location user/start.S) $(location user/shell.c) $(location user/ulib/string.c) $(location user/ulib/stdio.c) $(location user/ulib/unistd.c) $(location user/ulib/dirent.c) $(location user/ulib/gles.c) $(location user/ulib/gui.c) $(location user/ulib/ext4.c) -Iuser/ulib -Iinclude -o $@",
)

genrule(
    name = "user_shell_bin",
    srcs = [":user_shell_elf"],
    outs = ["user_shell.bin"],
    cmd = "aarch64-linux-gnu-objcopy -O binary $< $@",
)

genrule(
    name = "user_shell_h",
    srcs = [":user_shell_bin"],
    outs = ["user_shell_bin.h"],
    cmd = "python3 -c \"import sys; data=open(sys.argv[1],'rb').read(); open(sys.argv[2],'w').write('const unsigned char user_shell_bin[] = {' + ','.join(hex(b) for b in data) + '};\\nconst unsigned int user_shell_bin_len = ' + str(len(data)) + ';\\n')\" $< $@",
)

genrule(
    name = "arm64_kernel_elf",
    srcs = [
        "arch/arm64/boot.S",
        "arch/arm64/kernel/vector.S",
        "arch/arm64/kernel/switch.S",
        "arch/arm64/kernel/interrupt.c",
        "arch/arm64/kernel/task.c",
        "arch/arm64/kernel/krn.c",
        "driver/serial/pl011.c",
        "driver/interrupt/gicv2.c",
        "driver/timer/arm_timer.c",
        "driver/video/fb.c",
        "driver/mailbox/mbox.c",
        "lib/clib.c",
        "arch/arm64/kernel/kdbger.c",
        "arch/arm64/kernel.lds",
        ":user_shell_h",
    ] + glob(["include/**/*.h"]),
    outs = ["arm64_kernel.elf"],
    cmd = """
        aarch64-linux-gnu-gcc -Wall -O2 -nostdlib -nostartfiles -ffreestanding \
            -std=gnu89 \
            -mgeneral-regs-only \
            -DCONFIG_KDBGER=0 \
            -Iinclude -I. -I$(BINDIR) -I$(GENDIR) \
            -T $(location arch/arm64/kernel.lds) \
            $(location arch/arm64/boot.S) \
            $(location arch/arm64/kernel/vector.S) \
            $(location arch/arm64/kernel/switch.S) \
            $(location arch/arm64/kernel/interrupt.c) \
            $(location arch/arm64/kernel/task.c) \
            $(location arch/arm64/kernel/krn.c) \
            $(location arch/arm64/kernel/kdbger.c) \
            $(location driver/serial/pl011.c) \
            $(location driver/interrupt/gicv2.c) \
            $(location driver/timer/arm_timer.c) \
            $(location driver/video/fb.c) \
            $(location driver/mailbox/mbox.c) \
            $(location lib/clib.c) \
            -o $@
    """,
)

sh_binary(
    name = "run_qemu_arm64",
    srcs = ["run_qemu_arm64.sh"],
    data = [
        ":arm64_kernel_elf",
        "fat.img",
    ],
    args = ["$(location :arm64_kernel_elf)"],
)

genrule(
    name = "user_shell_elf_rpi4",
    srcs = [
        "user/shell.c",
        "user/start.S",
        "user/user.lds",
        "user/ulib/string.h",
        "user/ulib/string.c",
        "user/ulib/stdio.h",
        "user/ulib/stdio.c",
        "user/ulib/syscall.h",
        "user/ulib/unistd.h",
        "user/ulib/unistd.c",
        "user/ulib/dirent.h",
        "user/ulib/dirent.c",
        "user/ulib/gles.h",
        "user/ulib/gles.c",
        "user/ulib/gui.h",
        "user/ulib/gui.c",
        "user/ulib/gui_font.h",
        "user/ulib/ext4.h",
        "user/ulib/ext4.c",
    ] + glob(["include/**/*.h"]),
    outs = ["user_shell_rpi4.elf"],
    cmd = "aarch64-linux-gnu-gcc -Wall -O0 -nostdlib -nostartfiles -static -Wl,--build-id=none -ffreestanding -std=gnu89 -mgeneral-regs-only -DCONFIG_BOARD_RPI4=1 -T $(location user/user.lds) $(location user/start.S) $(location user/shell.c) $(location user/ulib/string.c) $(location user/ulib/stdio.c) $(location user/ulib/unistd.c) $(location user/ulib/dirent.c) $(location user/ulib/gles.c) $(location user/ulib/gui.c) $(location user/ulib/ext4.c) -Iuser/ulib -Iinclude -o $@",
)

genrule(
    name = "user_shell_bin_rpi4",
    srcs = [":user_shell_elf_rpi4"],
    outs = ["user_shell_rpi4.bin"],
    cmd = "aarch64-linux-gnu-objcopy -O binary $< $@",
)

genrule(
    name = "user_shell_h_rpi4",
    srcs = [":user_shell_bin_rpi4"],
    outs = ["user_shell_bin_rpi4.h"],
    cmd = "python3 -c \"import sys; data=open(sys.argv[1],'rb').read(); open(sys.argv[2],'w').write('const unsigned char user_shell_bin[] = {' + ','.join(hex(b) for b in data) + '};\\nconst unsigned int user_shell_bin_len = ' + str(len(data)) + ';\\n')\" $< $@",
)

genrule(
    name = "rpi4_kernel_elf",
    srcs = [
        "arch/arm64/boot.S",
        "arch/arm64/kernel/vector.S",
        "arch/arm64/kernel/switch.S",
        "arch/arm64/kernel/interrupt.c",
        "arch/arm64/kernel/task.c",
        "arch/arm64/kernel/krn.c",
        "driver/serial/pl011.c",
        "driver/interrupt/gicv2.c",
        "driver/timer/arm_timer.c",
        "driver/video/fb.c",
        "driver/mailbox/mbox.c",
        "lib/clib.c",
        "arch/arm64/kernel/kdbger.c",
        "arch/arm64/kernel.lds",
        ":user_shell_h_rpi4",
    ] + glob(["include/**/*.h"]),
    outs = ["rpi4_kernel.elf"],
    cmd = """
        aarch64-linux-gnu-gcc -Wall -O2 -nostdlib -nostartfiles -ffreestanding \
            -std=gnu89 \
            -mgeneral-regs-only \
            -DCONFIG_BOARD_RPI4=1 \
            -DCONFIG_KDBGER=0 \
            -Iinclude -I. -I$(BINDIR) -I$(GENDIR) \
            -T $(location arch/arm64/kernel.lds) \
            $(location arch/arm64/boot.S) \
            $(location arch/arm64/kernel/vector.S) \
            $(location arch/arm64/kernel/switch.S) \
            $(location arch/arm64/kernel/interrupt.c) \
            $(location arch/arm64/kernel/task.c) \
            $(location arch/arm64/kernel/krn.c) \
            $(location arch/arm64/kernel/kdbger.c) \
            $(location driver/serial/pl011.c) \
            $(location driver/interrupt/gicv2.c) \
            $(location driver/timer/arm_timer.c) \
            $(location driver/video/fb.c) \
            $(location driver/mailbox/mbox.c) \
            $(location lib/clib.c) \
            -o $@
    """,
)

sh_binary(
    name = "run_qemu_rpi4",
    srcs = ["run_qemu_rpi4.sh"],
    data = [
        ":rpi4_kernel_elf",
        "fat.img",
    ],
    args = ["$(location :rpi4_kernel_elf)"],
)

